# Copy to .env and adjust. Defaults match docker-compose.yml.

# MinIO (data lake)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password

# PostgreSQL (warehouse)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
# Alternatively a full SQLAlchemy URL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ecommerce_db

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=ecommerce_events

# Where bronze/silver/gold files are written locally
# DATA_DIR=./data

# Extra arguments for the Airflow DAG scraping step (e.g. --sample)
# PIPELINE_ARGS=--sample
